---
// Static on purpose: no hydration, so nothing re-renders or shifts after the page loads.
// Labels switch language via `html[lang]`, which is set before the first paint.
interface Props {
  active?: 'search' | 'favorites' | null;
}

const { active = null } = Astro.props;
---

<nav class="bottom-nav" aria-label="Основна навігація">
  <a
    href="/"
    class:list={{ active: active === 'search' }}
    aria-current={active === 'search' ? 'page' : undefined}
  >
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14ZM20 20l-3.5-3.5"></path>
    </svg>
    <span class="t-uk">Пошук</span>
    <span class="t-en">Search</span>
  </a>
  <a
    href="/favorites"
    class:list={{ active: active === 'favorites' }}
    aria-current={active === 'favorites' ? 'page' : undefined}
  >
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <path d="M12 20.5s-7.5-4.6-7.5-10.1A4.4 4.4 0 0 1 12 7.6a4.4 4.4 0 0 1 7.5 2.8c0 5.5-7.5 10.1-7.5 10.1Z"></path>
    </svg>
    <span class="t-uk">Улюблені</span>
    <span class="t-en">Favorites</span>
  </a>
</nav>

<style>
  .bottom-nav {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    height: calc(var(--nav-h) + var(--nav-safe));
    padding-bottom: var(--nav-safe);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    background: var(--header-bg);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-top: 1px solid var(--border);
  }

  a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 600;
  }

  a.active {
    color: var(--primary);
  }

  svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  a.active svg {
    fill: currentColor;
    fill-opacity: 0.18;
  }

  :global(html[lang='en']) .t-uk,
  :global(html:not([lang='en'])) .t-en {
    display: none;
  }

  @media (min-width: 900px) {
    .bottom-nav {
      left: 50%;
      right: auto;
      bottom: 16px;
      width: 320px;
      transform: translateX(-50%);
      height: var(--nav-h);
      padding-bottom: 0;
      border: 1px solid var(--border);
      border-radius: 999px;
      box-shadow: var(--shadow);
    }
  }
</style>
